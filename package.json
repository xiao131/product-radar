{
  "name": "product-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Evidence-driven product opportunity database for deciding what Web or iOS product to build next.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiao131/product-radar.git"
  },
  "bugs": {
    "url": "https://github.com/xiao131/product-radar/issues"
  },
  "homepage": "https://github.com/xiao131/product-radar#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:hash": "tsx server/hash-password.ts",
    "backup:restore": "tsx server/restore-backup.ts",
    "research:batch": "tsx server/batch-research.ts",
    "seed": "tsx server/seed.ts",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.24",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "ai": "7.0.40",
    "better-sqlite3": "13.0.1",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
