APP_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
TRUST_PROXY_HOPS=0

DATABASE_PATH=./data/product-radar.db
DATABASE_BUSY_TIMEOUT_MS=5000
SEED_DEMO_DATA=true

# 生产环境必须设为 true，并配置密码哈希和至少 32 字符的会话密钥。
AUTH_REQUIRED=false
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_HOURS=24

# 生产环境必须显式保留 demo，或改为 real 并配置下方 AI / DataForSEO 凭据。
RESEARCH_PROVIDER=demo
RESEARCH_FRESHNESS_DAYS=7
RESEARCH_KEYWORD_CACHE_DAYS=30
RESEARCH_SERP_CACHE_DAYS=14
RESEARCH_APP_CACHE_DAYS=30
RESEARCH_RATE_LIMIT_PER_HOUR=30
REQUEST_RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_15_MINUTES=10
MAX_AI_RUNS_PER_DAY=30
MAX_DATAFORSEO_TASKS_PER_DAY=100
# 自动发现与调研共享以下 DataForSEO 持久化美元硬上限。
MAX_DATAFORSEO_COST_PER_DAY_USD=0.5
MAX_DATAFORSEO_DISCOVERY_COST_PER_DAY_USD=0.05
MAX_DATAFORSEO_COST_PER_MONTH_USD=10
PROVIDER_REQUEST_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=2

MARKET_LOCATION_CODE=2840
MARKET_LANGUAGE_CODE=en
MARKET_COUNTRY_CODE=US
# 多市场格式：国家:位置代码:Google Ads 语言:SERP/App 语言。
RESEARCH_MARKETS=US:2840:en:en,CN:2156:zh_CN:zh-CN
COLLECT_WEB_COMPETITORS=true
COLLECT_APPLE_MARKET=true

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BATCH_POLL_INTERVAL_MS=60000
DATAFORSEO_BATCH_TIMEOUT_MS=14400000

# 每日低成本自动发现：Labs 关键词、Standard SERP、App Store 新品，再由 AI 聚类。
AUTO_DISCOVERY_ENABLED=false
DISCOVERY_LABS_LIMIT=100
DISCOVERY_LABS_FRESHNESS_DAYS=30
DISCOVERY_SERP_QUERIES_PER_MARKET=8
DISCOVERY_SERP_FRESHNESS_DAYS=3
DISCOVERY_APP_DEPTH=100
DISCOVERY_APP_FRESHNESS_DAYS=1
DISCOVERY_MAX_CANDIDATES_PER_RUN=5
DISCOVERY_AI_SIGNAL_LIMIT=120

SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_MS=900000
SCHEDULER_DISCOVERY_HOUR=3
SCHEDULER_RESEARCH_HOUR=3
SCHEDULER_BACKUP_HOUR=2
BACKUP_DIRECTORY=./data/backups
BACKUP_RETENTION_COUNT=14
ALERT_WEBHOOK_URL=

AI_PROVIDER=openai
OPENAI_BASE_URL=https://mdkj.lol
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
AI_REASONING_EFFORT=xhigh
AI_DISABLE_RESPONSE_STORAGE=true

# Anthropic Messages 协议：把 AI_PROVIDER 改为 anthropic。
# 未设置以下两项时，会兼容读取 OPENAI_API_KEY / OPENAI_BASE_URL，
# 并自动在 Base URL 后补 /v1。
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# 可选：改用 Vercel AI Gateway 时设置以下两项，
# 并把 AI_MODEL 改为 openai/gpt-5.6-terra。
AI_GATEWAY_API_KEY=
